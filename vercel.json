{
  "$schema": "https://json.schemastore.org/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets/|_tanstack/|favicon\\.|manifest\\.json|sw\\.js|robots\\.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
