# AgroNova Environment Configuration
# Copy this file to .env and fill in your values.

# ── Supabase (Required for auth & live farmer fields) ──────────────────────────
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ── Google Gemini AI (Required for Nova Chat, Crop Doctor Vision, Advisory) ────
# Get a FREE key from: https://aistudio.google.com/app/apikey
# Key format starts with: AIzaSy...
VITE_GEMINI_API_KEY="AIzaSy..."
GEMINI_API_KEY="AIzaSy..."

# ── NASA FIRMS (Optional – enables real-time fire/smoke alerts near fields) ────
# Register FREE at: https://firms.modaps.eosdis.nasa.gov/api/
# Without this key, fire monitoring shows "not active" (all other features work normally).
# VITE_FIRMS_MAP_KEY="your-firms-key"
